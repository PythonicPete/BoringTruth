
{
"manifest_version": 3,
"name": "Clickbait Deflater (Dev)",
"version": "1.0",
"description": "Replaces clickbait titles with boring truth.",
"permissions": [
"activeTab"
],
"host_permissions": [
"https://api.groq.com/"
],
"background": {
"service_worker": "background.js"
},
"content_scripts": [
{
"matches": [
"*://*.youtube.com/*",
  "*://*.medium.com/*",
  "*://news.ycombinator.com/*"
],
"css": ["styles.css"],
"js": ["content.js"]
}
],
"icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}